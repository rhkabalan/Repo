NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://game:game@localhost:5432/game
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-value-0123456789
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Comma-separated OAuth client IDs that are allowed to sign in
# (one each for Web, Android, iOS — all from the same Google Cloud project).
GOOGLE_CLIENT_IDS=

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*
